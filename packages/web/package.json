{
  "name": "@breath-in-flow/web",
  "version": "0.0.1",
  "description": "A breathing practice app for guided breathwork sessions",
  "author": {
    "name": "Breath in Flow",
    "email": "hello@breathinflow.app"
  },
  "homepage": "https://github.com/breathinflow/breath-in-flow",
  "private": true,
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "BUILD_TARGET=electron vite",
    "build": "vue-tsc -b && vite build",
    "build:electron": "BUILD_TARGET=electron vue-tsc -b && BUILD_TARGET=electron vite build",
    "build:mac": "pnpm build:electron && electron-builder --mac",
    "build:win": "pnpm build:electron && electron-builder --win",
    "build:linux": "pnpm build:electron && electron-builder --linux",
    "build:all": "pnpm build:electron && electron-builder --mac --win --linux",
    "cap:sync": "pnpm build && cap sync",
    "cap:ios": "pnpm build && cap sync ios && cap open ios",
    "cap:android": "pnpm build && cap sync android && cap open android",
    "cap:run:ios": "pnpm build && cap sync ios && cap run ios",
    "cap:run:android": "pnpm build && cap sync android && cap run android",
    "android:emulator": "pnpm build && cap sync android && cap run android --target Pixel_9_Pro_XL",
    "android:apk": "pnpm build && cap sync android && cd android && ./gradlew assembleDebug",
    "ios:simulator": "pnpm build && cap sync ios && cap run ios --target 'iPhone 16 Pro'",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --silent",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/core": "^7.4.4",
    "@capacitor/ios": "^7.4.4",
    "chart.js": "^4.5.1",
    "date-fns": "^4.1.0",
    "electron-squirrel-startup": "^1.0.1",
    "uuid": "^9.0.1",
    "vue": "^3.4.0",
    "vue-chartjs": "^5.3.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@breath-in-flow/database": "workspace:*",
    "@breath-in-flow/shared": "workspace:*",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.4.4",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "@vitejs/plugin-vue": "^4.5.2",
    "@vitest/coverage-v8": "^1.1.0",
    "@vue/test-utils": "^2.4.3",
    "autoprefixer": "^10.4.16",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "eslint-formatter-compact": "^9.0.1",
    "happy-dom": "^12.10.3",
    "postcss": "^8.4.32",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^1.1.0",
    "vue-tsc": "^2.2.12"
  }
}
