{
  "name": "breath-in-flow",
  "version": "0.0.3",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "license": "UNLICENSED",
  "type": "module",
  "description": "A breathing practice app for guided breathwork sessions",
  "scripts": {
    "dev": "pnpm --filter @breath-in-flow/web dev",
    "build": "pnpm --filter @breath-in-flow/shared build && pnpm --filter @breath-in-flow/web build",
    "preview": "pnpm --filter @breath-in-flow/web preview",
    "test": "pnpm test:build-script && pnpm --filter @breath-in-flow/shared test && pnpm --filter @breath-in-flow/database test && pnpm --filter @breath-in-flow/web test",
    "test:e2e": "pnpm --filter @breath-in-flow/web test:e2e",
    "test:build-script": "bash scripts/tests/build-script.test.sh",
    "test:coverage": "pnpm -r test:coverage",
    "db:generate": "pnpm --filter @breath-in-flow/database generate",
    "db:push": "pnpm --filter @breath-in-flow/database push",
    "db:studio": "pnpm --filter @breath-in-flow/database studio",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "build:all": "./scripts/build.sh all",
    "build:mac": "./scripts/build.sh mac",
    "build:win": "./scripts/build.sh win",
    "build:linux": "./scripts/build.sh linux",
    "build:desktop": "./scripts/build.sh desktop",
    "build:android": "./scripts/build.sh android",
    "build:ios": "./scripts/build.sh ios",
    "build:mobile": "./scripts/build.sh mobile",
    "build:web": "./scripts/build.sh web",
    "postinstall": "pnpm db:generate",
    "generate:voices": "node scripts/generate-kokoro-cues.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.12.0",
    "kokoro-js": "1.2.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  }
}
